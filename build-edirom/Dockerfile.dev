##########################
# Development Dockerfile #
# For local testing      #
##########################

FROM python:3.11-slim-bookworm

# Install runtime tools needed for local debugging and content generation
RUN apt-get update && apt-get install -y \
    libxslt1.1 \
    libxml2-utils \
    xsltproc \
    git \
    curl \
    unzip \
    openjdk-17-jre-headless \
    basex \
    python3-dev \
    build-essential \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --no-cache-dir lxml

# Create user with UID 1000 for host compatibility
RUN useradd -m -u 1000 -s /bin/bash appuser

# Set working directory for the bind-mounted project
WORKDIR /app

# Ensure Python output is unbuffered for docker logs
ENV PYTHONUNBUFFERED=1

# Create tmp directory with proper permissions for mounted volumes
RUN mkdir -p /app/tmp /output && chown -R appuser:appuser /app/tmp /output && chmod -R 755 /app/tmp /output

USER appuser

# Keep the container alive for interactive debugging
CMD ["/bin/bash"]
